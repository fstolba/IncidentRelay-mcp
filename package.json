{
  "name": "incidentrelay-mcp",
  "version": "0.1.0",
  "description": "MCP server for IncidentRelay on-call / incident management",
  "type": "module",
  "bin": {
    "incidentrelay-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "src/openapi/snapshot.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:snapshot",
    "copy:snapshot": "node -e \"const fs=require('fs');fs.mkdirSync('dist/openapi',{recursive:true});fs.copyFileSync('src/openapi/snapshot.json','dist/openapi/snapshot.json')\"",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "incidentrelay",
    "on-call",
    "incident-management",
    "alerting"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikGariel/IncidentRelay-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "undici": "^6.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "msw": "^2.15.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  }
}
